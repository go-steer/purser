# Run the end-to-end example under both mTLS profiles.
#
# The unit suite covers the library and the example's own packages. This
# covers the seam between them: real processes, real sockets, real
# handshakes, and the flags a human actually types. It is deliberately
# the same script the README tells a reader to run, so a broken demo
# fails CI rather than a reader's first five minutes.
#
# Needs no network and no credentials — the demo mints its own into a
# temporary directory.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

exec examples/local/demo both
